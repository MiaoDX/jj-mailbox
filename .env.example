# jj-mailbox environment variables
# Copy to .env and fill in values
# See docs/MODEL_CHOICES.md for all provider options

# =============================================================================
# LLM Provider (used by Level 3a, 3b, OpenClaw tests, and demos)
# =============================================================================
# Any OpenAI-compatible API works. Pick ONE provider below.
# See docs/MODEL_CHOICES.md for full comparison.

# --- OpenRouter (default, easiest) ---
# Sign up: https://openrouter.ai/ (free, no credit card)
LLM_API_KEY=sk-or-...
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# --- Groq (fastest) ---
# LLM_API_KEY=gsk_...
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Cerebras (most generous limits) ---
# LLM_API_KEY=csk-...
# LLM_API_BASE=https://api.cerebras.ai/v1
# LLM_MODEL=llama-3.3-70b

# --- Google AI Studio (best model quality) ---
# LLM_API_KEY=AIza...
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash

# --- Local ollama (offline) ---
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# OLLAMA=1

# =============================================================================
# Hugging Face (Level 2b smolagents only)
# =============================================================================
# Get your token at: https://hf.co/settings/tokens
HF_TOKEN=hf_...
