# jj-mailbox environment variables
# Copy to .env and fill in values for local development

# =============================================================================
# Level 2b: smolagents (Hugging Face)
# =============================================================================
# Get your token at: https://hf.co/settings/tokens
HF_TOKEN=hf_...

# =============================================================================
# Level 3a: Free LLM agent (tool-calling)
# =============================================================================

# --- Option A: Local ollama (recommended for dev) ---
# Install: https://ollama.ai/
# Run: ollama pull qwen2.5:0.5b
# LLM_API_KEY=ollama
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:0.5b
# OLLAMA=1    # set this flag to use local defaults

# --- Option B: Free online API via OpenRouter ---
# Sign up at: https://openrouter.ai/ (free tier available)
LLM_API_KEY=sk-or-...
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=xiaomi/mimo-v2-flash:free

# =============================================================================
# Level 3b: Quality LLM (Kimi / Moonshot)
# =============================================================================
# Uncomment to use Kimi instead of free model
# LLM_API_BASE=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
# LLM_API_KEY=sk-...   # Moonshot API key
