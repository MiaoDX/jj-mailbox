#!/usr/bin/env bash
# jj-mailbox sync daemon
# Periodically syncs the mailbox repo via jj + git remote
set -euo pipefail

VERSION="0.1.0"
DEFAULT_INTERVAL=30

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
ok()  { echo -e "${GREEN}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
warn(){ echo -e "${YELLOW}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
err() { echo -e "${RED}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*" >&2; }

usage() {
  cat <<EOF
jj-mailbox v${VERSION} — file-based message passing for AI agents

Usage:
  jj-mailbox init <repo-path> [--remote <git-url>]    Initialize a mailbox repo
  jj-mailbox register <name> [--desc <description>]    Register an agent
  jj-mailbox send <to> <subject> <body> [--refs <ids>] [--type <kind>]  Send a message (--refs: comma-separated ids)
  jj-mailbox inbox [--agent <name>]                    Check inbox
  jj-mailbox thread <msg-id>                           Show a conversation thread
  jj-mailbox task create <subject> [options]           Create a shared task
  jj-mailbox task claim                                Claim highest priority ready task
  jj-mailbox task complete <task-id>                   Complete a task (runs hooks if configured)
  jj-mailbox task list                                 Show shared task board
  jj-mailbox sync [--interval <seconds>]               Run sync loop
  jj-mailbox watch [--agent <name>] [--exec <command>] Watch inbox for new local messages
  jj-mailbox status                                    Show all agents' status
  jj-mailbox help                                      Show this help

Environment:
  JJ_MAILBOX_REPO     Path to mailbox repo (default: current directory)
  JJ_MAILBOX_AGENT    Current agent name (default: hostname)
  JJ_MAILBOX_INTERVAL Sync interval in seconds (default: ${DEFAULT_INTERVAL})
EOF
}

# --- Helpers ---

get_repo() {
  echo "${JJ_MAILBOX_REPO:-$(pwd)}"
}

get_agent() {
  echo "${JJ_MAILBOX_AGENT:-$(hostname)}"
}

ensure_repo() {
  local repo
  repo="$(get_repo)"
  if [[ ! -d "${repo}/.jj" ]]; then
    err "Not a jj-mailbox repo: ${repo}"
    err "Run 'jj-mailbox init <path>' first."
    exit 1
  fi
}

ensure_jj() {
  if ! command -v jj &>/dev/null; then
    err "jj (Jujutsu) is not installed."
    err "Install: https://jj-vcs.dev/docs/install/"
    exit 1
  fi
}

gen_id() {
  # Try multiple methods for portability
  if command -v xxd &>/dev/null; then
    head -c 4 /dev/urandom | xxd -p
  elif command -v od &>/dev/null; then
    head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'
  else
    printf '%04x%04x' $RANDOM $RANDOM
  fi
}

ts_filename() {
  date -u +"%Y-%m-%dT%H-%M-%SZ"
}

ts_iso() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

python_json_update() {
  local path="${1:?}"
  local py_script="${2:?}"
  shift 2 || true
  python3 - "$path" "$@" <<PY
import json
import sys

path = sys.argv[1]
with open(path) as f:
    payload = json.load(f)

${py_script}

with open(path, "w") as f:
    json.dump(payload, f, indent=2)
    f.write("\\n")
PY
}

update_agent_status() {
  local agent="${1:?}"
  local status="${2:?}"
  local current_task="${3:-__KEEP__}"
  local completed_task="${4:-}"
  local repo
  repo="$(get_repo)"
  local path="${repo}/agents/${agent}/status.json"
  [[ -f "${path}" ]] || return 0

  python_json_update "${path}" '
payload["status"] = sys.argv[2]
payload["last_seen"] = sys.argv[3]
current_task = sys.argv[4]
completed_task = sys.argv[5]
if current_task != "__KEEP__":
    payload["current_task"] = None if current_task == "__NULL__" else current_task
if completed_task:
    completed = payload.setdefault("completed_tasks", [])
    if completed_task not in completed:
        completed.append(completed_task)
if payload.get("status") == "idle":
    payload["available_since"] = sys.argv[3]
' "${status}" "$(ts_iso)" "${current_task}" "${completed_task}" 2>/dev/null || true
}

# --- Commands ---

run_exec_hook() {
  local exec_cmd="${1:-}"
  [[ -z "${exec_cmd}" ]] && return 0

  log "Running hook: ${exec_cmd}"
  bash -c "${exec_cmd}"
}

watch_with_polling() {
  local inbox_dir="${1:?}"
  local exec_cmd="${2:-}"
  local poll_interval="${3:-3}"
  local baseline=0

  baseline=$(find "${inbox_dir}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
  while true; do
    local count
    count=$(find "${inbox_dir}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${count}" -gt "${baseline}" ]]; then
      local delta=$((count - baseline))
      ok "📬 ${delta} new message(s) detected"
      run_exec_hook "${exec_cmd}"
    fi
    baseline="${count}"
    sleep "${poll_interval}"
  done
}

cmd_init() {
  ensure_jj
  local repo="${1:-.}"
  local remote="${2:-}"

  mkdir -p "${repo}"
  cd "${repo}"

  if [[ -d .jj ]]; then
    warn "Already initialized: ${repo}"
    return 0
  fi

  # Initialize jj with git backend
  if [[ -n "${remote}" ]]; then
    log "Cloning from ${remote}..."
    jj git clone --colocate "${remote}" .
  else
    log "Initializing new mailbox repo..."
    jj git init --colocate
  fi

  # Create directory structure
  mkdir -p agents inbox shared/{tasks,knowledge,artifacts} config

  # Create AGENTS.md
  cat > AGENTS.md <<'AGENTS'
# Registered Agents

| Name | Description | Status |
|------|-------------|--------|

<!-- Auto-updated by jj-mailbox -->
AGENTS

  # Create .gitignore
  cat > .gitignore <<'GI'
# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.swp
GI

  cat > config/hooks.yaml <<'HOOKS'
# Hooks run during `jj-mailbox task complete`.
# exit 0 = pass, exit 2 = reject completion and send stderr feedback to the assignee.
on_task_complete: []
HOOKS

  jj commit -m "Initialize jj-mailbox repo"

  ok "Mailbox repo initialized at: $(pwd)"
  if [[ -z "${remote}" ]]; then
    log "Tip: add a remote with 'jj git remote add origin <url>'"
  fi
}

cmd_register() {
  ensure_repo
  ensure_jj
  local name="${1:?Usage: jj-mailbox register <name>}"
  local desc="${2:-Agent ${name}}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  # Create agent directories
  mkdir -p "agents/${name}" "inbox/${name}/new" "inbox/${name}/processed"

  # Write profile
  cat > "agents/${name}/profile.json" <<EOF
{
  "name": "${name}",
  "description": "${desc}",
  "capabilities": [],
  "platform": "openclaw",
  "created": "$(ts_iso)"
}
EOF

  # Write initial status
  cat > "agents/${name}/status.json" <<EOF
{
  "status": "online",
  "last_seen": "$(ts_iso)",
  "current_task": null,
  "completed_tasks": [],
  "available_since": null,
  "capabilities": []
}
EOF

  # Add placeholder to keep dirs in git
  touch "inbox/${name}/new/.gitkeep"
  touch "inbox/${name}/processed/.gitkeep"

  jj commit -m "Register agent: ${name}"

  ok "Agent '${name}' registered."
  log "Set JJ_MAILBOX_AGENT=${name} to use as current agent."
}

cmd_send() {
  ensure_repo
  ensure_jj
  local to="${1:?Usage: jj-mailbox send <to> <subject> <body> [--refs <id1,id2,...>]}"
  local subject="${2:?}"
  local body="${3:?}"
  local refs_arg=""
  local msg_type="message"
  local from
  from="$(get_agent)"
  local repo
  repo="$(get_repo)"

  # Parse optional --refs flag (remaining args after positional 3)
  shift 3 || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --refs) refs_arg="${2:-}"; shift 2 ;;
      --type) msg_type="${2:-message}"; shift 2 ;;
      *) shift ;;
    esac
  done

  cd "${repo}"

  # Verify recipient exists
  if [[ ! -d "inbox/${to}/new" ]]; then
    err "Unknown agent: ${to}"
    err "Registered agents:"
    ls agents/ 2>/dev/null || echo "  (none)"
    exit 1
  fi

  local msg_id="msg-$(gen_id)"
  local ts
  ts="$(ts_filename)"
  local filename="${ts}_${from}_${msg_id}.json"

  # Build refs JSON array from comma-separated ids (pure bash, no python)
  local refs_json="[]"
  if [[ -n "${refs_arg}" ]]; then
    local _refs_arr _r _first=true
    refs_json="["
    IFS=',' read -ra _refs_arr <<< "${refs_arg}"
    for _r in "${_refs_arr[@]}"; do
      _r="${_r// /}"
      [[ -z "${_r}" ]] && continue
      ${_first} || refs_json+=","
      refs_json+="\"${_r}\""
      _first=false
    done
    refs_json+="]"
  fi

  case "${msg_type}" in
    message|task|reply|broadcast|idle|approval_request|approval_response|shutdown) ;;
    *)
      err "Unsupported message type: ${msg_type}"
      exit 1
      ;;
  esac

  cat > "inbox/${to}/new/${filename}" <<EOF
{
  "version": "0.1",
  "id": "${msg_id}",
  "timestamp": "$(ts_iso)",
  "from": "${from}",
  "to": "${to}",
  "type": "${msg_type}",
  "subject": "${subject}",
  "body": "${body}",
  "refs": ${refs_json},
  "metadata": {}
}
EOF

  jj commit -m "${from} → ${to}: ${subject}"

  ok "Message sent: ${from} → ${to}"
  log "  Subject: ${subject}"
  log "  File: inbox/${to}/new/${filename}"
  log "  ID: ${msg_id}"
  echo "${msg_id}"
}

next_task_id() {
  local repo
  repo="$(get_repo)"
  python3 - "${repo}/shared/tasks" <<'PY'
import json
import os
import re
import sys

task_dir = sys.argv[1]
max_id = 0
if os.path.isdir(task_dir):
    for name in os.listdir(task_dir):
        if not name.endswith(".json"):
            continue
        match = re.fullmatch(r"task-(\d+)\.json", name)
        if match:
            max_id = max(max_id, int(match.group(1)))
print(f"task-{max_id + 1:03d}")
PY
}

task_path() {
  local task_id="${1:?}"
  echo "$(get_repo)/shared/tasks/${task_id}.json"
}

task_send_hook_feedback() {
  local assignee="${1:?}"
  local task_id="${2:?}"
  local hook_name="${3:?}"
  local stderr_file="${4:?}"
  local repo
  repo="$(get_repo)"
  local msg_id="msg-$(gen_id)"
  local filename
  filename="$(ts_filename)_system_${msg_id}.json"
  local body
  body="$(python3 - "$stderr_file" <<'PY'
import json
import sys

with open(sys.argv[1]) as f:
    text = f.read().strip()
print(json.dumps(text or "Hook rejected completion without stderr output."))
PY
)"

  cat > "${repo}/inbox/${assignee}/new/${filename}" <<EOF
{
  "version": "0.1",
  "id": "${msg_id}",
  "timestamp": "$(ts_iso)",
  "from": "system",
  "to": "${assignee}",
  "type": "reply",
  "subject": "Task ${task_id} completion rejected: ${hook_name}",
  "body": ${body},
  "refs": ["${task_id}"],
  "metadata": {
    "hook": "${hook_name}",
    "task_id": "${task_id}"
  }
}
EOF
}

run_task_complete_hooks() {
  local task_id="${1:?}"
  local assignee="${2:-}"
  local repo
  repo="$(get_repo)"
  local config="${repo}/config/hooks.yaml"
  [[ -f "${config}" ]] || return 0

  local hooks_json
  hooks_json="$(python3 - "${config}" <<'PY'
import json
import sys

path = sys.argv[1]
hooks = []
in_section = False
current = None

with open(path) as f:
    for raw in f:
        line = raw.rstrip("\n")
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not line.startswith(" ") and stripped.startswith("on_task_complete:"):
            in_section = True
            continue
        if not in_section:
            continue
        if not line.startswith("  "):
            break
        if stripped.startswith("- "):
            if current:
                hooks.append(current)
            current = {}
            stripped = stripped[2:].strip()
            if stripped.startswith("name:"):
                current["name"] = stripped.split(":", 1)[1].strip().strip("\"'")
        elif ":" in stripped and current is not None:
            key, value = stripped.split(":", 1)
            current[key.strip()] = value.strip().strip("\"'")
if current:
    hooks.append(current)

print(json.dumps(hooks))
PY
)"

  local hook_count
  hook_count="$(python3 -c 'import json,sys; print(len(json.loads(sys.argv[1])))' "${hooks_json}")"
  [[ "${hook_count}" -eq 0 ]] && return 0

  while IFS=$'\t' read -r hook_name hook_cmd; do
    [[ -n "${hook_cmd}" ]] || continue
    local stdout_file stderr_file
    stdout_file="$(mktemp)"
    stderr_file="$(mktemp)"
    local exit_code=0
    if TASK_ID="${task_id}" TASK_WORKSPACE="${repo}" TASK_ASSIGNEE="${assignee}" bash -c "${hook_cmd}" >"${stdout_file}" 2>"${stderr_file}"; then
      rm -f "${stdout_file}" "${stderr_file}"
      continue
    else
      exit_code=$?
    fi
    if [[ "${exit_code}" -eq 2 ]]; then
      [[ -n "${assignee}" ]] && task_send_hook_feedback "${assignee}" "${task_id}" "${hook_name}" "${stderr_file}"
      warn "Hook rejected completion: ${hook_name}"
      cat "${stderr_file}" >&2 || true
      rm -f "${stdout_file}" "${stderr_file}"
      return 2
    fi
    err "Hook failed: ${hook_name} (exit ${exit_code})"
    cat "${stderr_file}" >&2 || true
    rm -f "${stdout_file}" "${stderr_file}"
    return "${exit_code}"
  done < <(python3 -c 'import json,sys
for h in json.loads(sys.argv[1]):
    print("{}\t{}".format(h.get("name", "hook"), h.get("command", "")))' "${hooks_json}")
}

cmd_task_create() {
  ensure_repo
  ensure_jj
  local subject="${1:?Usage: jj-mailbox task create <subject> [--priority N] [--blocked-by id1,id2] [--assignee name]}"
  shift || true
  local priority=100
  local blocked_by=""
  local assignee="null"
  local created_by
  created_by="$(get_agent)"
  local repo
  repo="$(get_repo)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --priority) priority="${2:?}"; shift 2 ;;
      --blocked-by) blocked_by="${2:-}"; shift 2 ;;
      --assignee) assignee="\"${2:?}\""; shift 2 ;;
      *)
        err "Unknown option for task create: $1"
        exit 1
        ;;
    esac
  done

  cd "${repo}"
  local task_id
  task_id="$(next_task_id)"

  local blocked_json="[]"
  if [[ -n "${blocked_by}" ]]; then
    blocked_json="$(python3 -c 'import json,sys; print(json.dumps([x.strip() for x in sys.argv[1].split(",") if x.strip()]))' "${blocked_by}")"
  fi

  cat > "shared/tasks/${task_id}.json" <<EOF
{
  "id": "${task_id}",
  "subject": "${subject}",
  "activeForm": "${subject}",
  "status": "pending",
  "assignee": ${assignee},
  "created_by": "${created_by}",
  "created_at": "$(ts_iso)",
  "priority": ${priority},
  "blocks": [],
  "blockedBy": ${blocked_json},
  "metadata": {}
}
EOF

  jj commit -m "Create task: ${task_id} ${subject}"
  ok "Task created: ${task_id}"
  echo "${task_id}"
}

cmd_task_claim() {
  ensure_repo
  ensure_jj
  local repo agent
  repo="$(get_repo)"
  agent="$(get_agent)"
  cd "${repo}"

  local task_id
  task_id="$(python3 - "shared/tasks" "${agent}" <<'PY'
import json
import os
import sys

task_dir = sys.argv[1]
ready = []
tasks = {}
for name in os.listdir(task_dir):
    if not name.endswith(".json"):
        continue
    path = os.path.join(task_dir, name)
    with open(path) as f:
        task = json.load(f)
    tasks[task["id"]] = task

for task in tasks.values():
    if task.get("status") != "pending":
        continue
    blocked_by = task.get("blockedBy", [])
    if any(tasks.get(dep, {}).get("status") != "completed" for dep in blocked_by):
        continue
    ready.append(task)

ready.sort(key=lambda t: (t.get("priority", 9999), t.get("created_at", ""), t["id"]))
print(ready[0]["id"] if ready else "")
PY
)"

  if [[ -z "${task_id}" ]]; then
    warn "No ready pending tasks to claim."
    return 1
  fi

  local path="shared/tasks/${task_id}.json"
  python_json_update "${path}" '
payload["status"] = "in_progress"
payload["assignee"] = sys.argv[2]
payload.setdefault("metadata", {})
payload["metadata"]["claimed_at"] = sys.argv[3]
' "${agent}" "$(ts_iso)"

  update_agent_status "${agent}" "busy" "${task_id}"
  jj commit -m "Claim task: ${task_id} by ${agent}"
  ok "Claimed task: ${task_id}"
  echo "${task_id}"
}

cmd_task_complete() {
  ensure_repo
  ensure_jj
  local task_id="${1:?Usage: jj-mailbox task complete <task-id>}"
  local repo path assignee agent
  repo="$(get_repo)"
  path="$(task_path "${task_id}")"
  agent="$(get_agent)"
  [[ -f "${path}" ]] || { err "Task not found: ${task_id}"; exit 1; }
  cd "${repo}"

  assignee="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("assignee") or "")' "${path}")"
  if [[ -n "${assignee}" && "${assignee}" != "${agent}" ]]; then
    err "Task ${task_id} is assigned to ${assignee}, not ${agent}"
    exit 1
  fi

  run_task_complete_hooks "${task_id}" "${assignee:-${agent}}" || {
    local hook_status=$?
    return "${hook_status}"
  }

  python_json_update "${path}" '
payload["status"] = "completed"
payload.setdefault("metadata", {})
payload["metadata"]["completed_at"] = sys.argv[2]
if not payload.get("assignee"):
    payload["assignee"] = sys.argv[3]
' "$(ts_iso)" "${agent}"

  update_agent_status "${agent}" "idle" "__NULL__" "${task_id}"
  jj commit -m "Complete task: ${task_id} by ${agent}"
  ok "Completed task: ${task_id}"
}

cmd_task_list() {
  ensure_repo
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  python3 - "shared/tasks" <<'PY'
import json
import os
import sys

task_dir = sys.argv[1]
tasks = []
for name in sorted(os.listdir(task_dir)):
    if not name.endswith(".json"):
        continue
    path = os.path.join(task_dir, name)
    with open(path) as f:
        tasks.append(json.load(f))

if not tasks:
    print("No tasks.")
    raise SystemExit(0)

tasks.sort(key=lambda t: (t.get("status", ""), t.get("priority", 9999), t.get("id", "")))
for task in tasks:
    blocked = ",".join(task.get("blockedBy", [])) or "-"
    assignee = task.get("assignee") or "-"
    print(f'{task["id"]}\t{task.get("status","?")}\tP{task.get("priority",9999)}\t{assignee}\tblockedBy={blocked}\t{task.get("subject","")}')
PY
}

cmd_task() {
  local subcmd="${1:-list}"
  shift || true
  case "${subcmd}" in
    create)   cmd_task_create "$@" ;;
    claim)    cmd_task_claim "$@" ;;
    complete) cmd_task_complete "$@" ;;
    list)     cmd_task_list "$@" ;;
    *)
      err "Unknown task subcommand: ${subcmd}"
      exit 1
      ;;
  esac
}

cmd_inbox() {
  ensure_repo
  local agent="${1:-$(get_agent)}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  if [[ ! -d "${inbox_dir}" ]]; then
    err "No inbox for agent: ${agent}"
    exit 1
  fi

  local count
  count=$(find "${inbox_dir}" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')

  if [[ "${count}" -eq 0 ]]; then
    log "Inbox empty for ${agent}."
    return 0
  fi

  ok "${count} message(s) for ${agent}:"
  echo ""

  # Sort by filename (which starts with timestamp)
  find "${inbox_dir}" -name '*.json' | sort | while read -r f; do
    local from subject ts _fields
    # Single python3 call to extract all fields (instead of 3 separate calls)
    # Uses sys.argv to pass file path safely (no bash variable interpolation in python)
    _fields=$(python3 -c "
import json,sys
m=json.load(open(sys.argv[1]))
print(m.get('from','?') + '\t' + m.get('subject','?') + '\t' + m.get('timestamp','?'))
" "$f" 2>/dev/null) || _fields=$'?\t?\t?'
    IFS=$'\t' read -r from subject ts <<< "${_fields}"
    echo -e "  ${GREEN}From:${NC} ${from}  ${BLUE}Subject:${NC} ${subject}  ${YELLOW}Time:${NC} ${ts}"
  done
  echo ""
}

cmd_thread() {
  ensure_repo
  local msg_id="${1:?Usage: jj-mailbox thread <msg-id>}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  python3 - "$msg_id" <<'PY'
import json
import os
import sys
from collections import defaultdict

target_id = sys.argv[1]
messages = {}
children = defaultdict(list)

for root, _, files in os.walk("inbox"):
    for name in files:
        if not name.endswith(".json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path) as f:
                msg = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        msg_id = msg.get("id")
        if not msg_id:
            continue
        msg["_path"] = path
        msg.setdefault("refs", [])
        messages[msg_id] = msg

for msg in messages.values():
    for ref in msg.get("refs", []):
        if ref in messages:
            children[ref].append(msg["id"])

if target_id not in messages:
    print(f"Message not found: {target_id}", file=sys.stderr)
    sys.exit(1)

component = set()
stack = [target_id]
while stack:
    current = stack.pop()
    if current in component:
        continue
    component.add(current)
    msg = messages[current]
    for ref in msg.get("refs", []):
        if ref in messages:
            stack.append(ref)
    stack.extend(children.get(current, []))

def in_component_refs(msg_id):
    return [ref for ref in messages[msg_id].get("refs", []) if ref in component]

roots = [
    msg_id for msg_id in component
    if not in_component_refs(msg_id)
]
if not roots:
    roots = [target_id]

def sort_key(msg_id):
    msg = messages[msg_id]
    return (msg.get("timestamp", ""), msg_id)

turn = 0
seen = set()

def render(msg_id, depth):
    global turn
    if msg_id in seen:
        return
    seen.add(msg_id)
    turn += 1
    msg = messages[msg_id]
    indent = "  " * depth
    refs = [ref for ref in msg.get("refs", []) if ref]
    refs_suffix = f"  [refs: {', '.join(refs)}]" if refs else ""
    print(
        f"{indent}Turn {turn}  "
        f"{msg.get('from', '?')} → {msg.get('to', '?')}  "
        f"\"{msg.get('subject', '?')}\"{refs_suffix}"
    )
    for child_id in sorted(children.get(msg_id, []), key=sort_key):
        if child_id in component:
            render(child_id, depth + 1)

for root_id in sorted(roots, key=sort_key):
    render(root_id, 0)

PY
}

cmd_read_and_process() {
  # Read one message and move to processed
  ensure_repo
  local agent="${1:-$(get_agent)}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  local processed_dir="inbox/${agent}/processed"

  local oldest
  oldest=$(find "${inbox_dir}" -name '*.json' 2>/dev/null | sort | head -1)

  if [[ -z "${oldest}" ]]; then
    echo ""
    return 1
  fi

  # Output the message content
  cat "${oldest}"

  # Move to processed
  mv "${oldest}" "${processed_dir}/"

  return 0
}

cmd_sync() {
  ensure_repo
  ensure_jj
  local interval="${1:-${JJ_MAILBOX_INTERVAL:-${DEFAULT_INTERVAL}}}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  log "Starting sync loop (interval: ${interval}s)"
  log "Repo: ${repo}"
  log "Press Ctrl+C to stop."
  echo ""

  while true; do
    # Update agent status
    local agent
    agent="$(get_agent)"
    if [[ -f "agents/${agent}/status.json" ]]; then
      # Pass file path and timestamp as arguments (no bash variable interpolation in python)
      update_agent_status "${agent}" "$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("status","online"))' "agents/${agent}/status.json" 2>/dev/null || echo online)" "__KEEP__"
    fi

    # Fetch
    if jj git fetch --all-remotes 2>/dev/null; then
      log "⬇ Fetched remote changes"
    fi

    # Snapshot working copy (jj does this automatically)
    jj status >/dev/null 2>&1 || true

    # Check inbox
    local count
    count=$(find "inbox/${agent}/new" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${count}" -gt 0 ]]; then
      ok "📬 ${count} new message(s) in inbox"
    fi

    # Push
    if jj git push --all 2>/dev/null; then
      log "⬆ Pushed local changes"
    fi

    sleep "${interval}"
  done
}

cmd_watch() {
  ensure_repo
  local agent="$(get_agent)"
  local exec_cmd=""
  local repo
  repo="$(get_repo)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        agent="${2:?Usage: jj-mailbox watch [--agent <name>] [--exec <command>]}"
        shift 2
        ;;
      --exec)
        exec_cmd="${2:?Usage: jj-mailbox watch [--agent <name>] [--exec <command>]}"
        shift 2
        ;;
      *)
        err "Unknown option for watch: $1"
        exit 1
        ;;
    esac
  done

  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  if [[ ! -d "${inbox_dir}" ]]; then
    err "No inbox for agent: ${agent}"
    exit 1
  fi

  log "Watching ${inbox_dir} for new messages"
  if [[ -n "${exec_cmd}" ]]; then
    log "Hook command enabled"
  fi
  log "Press Ctrl+C to stop."

  if [[ "${JJ_MAILBOX_FORCE_POLL:-0}" == "1" ]]; then
    warn "Forced polling mode enabled"
    watch_with_polling "${inbox_dir}" "${exec_cmd}" 3
  elif command -v inotifywait >/dev/null 2>&1; then
    inotifywait -m -e create --format '%f' "${inbox_dir}" | while read -r file; do
      [[ "${file}" == *.json ]] || continue
      ok "📬 New message detected: ${file}"
      run_exec_hook "${exec_cmd}"
    done
  elif command -v fswatch >/dev/null 2>&1; then
    fswatch -0 --event Created "${inbox_dir}" | while IFS= read -r -d '' file; do
      [[ "${file}" == *.json ]] || continue
      ok "📬 New message detected: $(basename "${file}")"
      run_exec_hook "${exec_cmd}"
    done
  else
    warn "No inotifywait or fswatch found, falling back to 3s polling"
    watch_with_polling "${inbox_dir}" "${exec_cmd}" 3
  fi
}

cmd_status() {
  ensure_repo
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  log "Agent Status:"
  echo ""

  for agent_dir in agents/*/; do
    [[ -d "${agent_dir}" ]] || continue
    local name
    name=$(basename "${agent_dir}")
    local status="?"
    local last_seen="?"
    local inbox_count=0

    if [[ -f "${agent_dir}/status.json" ]]; then
      # Single python3 call to extract both fields (instead of 2 separate calls)
      local _status_fields
      _status_fields=$(python3 -c "
import json,sys
s=json.load(open(sys.argv[1]))
print(s.get('status','?'), s.get('last_seen','?'))
" "${agent_dir}/status.json" 2>/dev/null) || _status_fields="? ?"
      read -r status last_seen <<< "${_status_fields}"
    fi

    if [[ -d "inbox/${name}/new" ]]; then
      inbox_count=$(find "inbox/${name}/new" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    fi

    local status_icon="⚪"
    [[ "${status}" == "online" ]] && status_icon="🟢"
    [[ "${status}" == "busy" ]] && status_icon="🟡"
    [[ "${status}" == "idle" ]] && status_icon="💤"
    [[ "${status}" == "offline" ]] && status_icon="🔴"
    [[ "${status}" == "waiting_approval" ]] && status_icon="🟣"

    echo -e "  ${status_icon} ${name}  (${status})  📬 ${inbox_count} msg  🕐 ${last_seen}"
  done
  echo ""
}

# --- Main ---

main() {
  local cmd="${1:-help}"
  shift || true

  case "${cmd}" in
    init)     cmd_init "$@" ;;
    register) cmd_register "$@" ;;
    send)     cmd_send "$@" ;;
    inbox)    cmd_inbox "$@" ;;
    thread)   cmd_thread "$@" ;;
    read)     cmd_read_and_process "$@" ;;
    task)     cmd_task "$@" ;;
    sync)     cmd_sync "$@" ;;
    watch)    cmd_watch "$@" ;;
    status)   cmd_status "$@" ;;
    version)  echo "jj-mailbox v${VERSION}" ;;
    help|*)   usage ;;
  esac
}

main "$@"
