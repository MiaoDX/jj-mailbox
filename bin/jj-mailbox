#!/usr/bin/env bash
# jj-mailbox sync daemon
# Periodically syncs the mailbox repo via jj + git remote
set -euo pipefail

VERSION="0.1.0"
DEFAULT_INTERVAL=30

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { echo -e "${BLUE}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
ok()  { echo -e "${GREEN}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
warn(){ echo -e "${YELLOW}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*"; }
err() { echo -e "${RED}[jj-mailbox]${NC} $(date -u +%H:%M:%S) $*" >&2; }

usage() {
  cat <<EOF
jj-mailbox v${VERSION} — file-based message passing for AI agents

Usage:
  jj-mailbox init <repo-path> [--remote <git-url>]         Initialize a mailbox repo
  jj-mailbox register <name> [--desc <description>]         Register an agent
  jj-mailbox send <to> <subject> <body> [flags]             Send a message
      --refs <id1,id2,...>   Reference previous message IDs
      --type <type>          Message type (default: message)
          Types: message, task, reply, broadcast,
                 idle, approval_request, approval_response, shutdown
  jj-mailbox inbox [--agent <name>]                         Check inbox
  jj-mailbox thread <msg-id>                                Show a conversation thread
  jj-mailbox read [<agent>]                                 Read & process oldest message
  jj-mailbox set-status <status> [--task <task-id>]         Update agent status
      Statuses: online, busy, idle, offline, waiting_approval
  jj-mailbox task create <subject> [--priority <n>] [--blocked-by <ids>]
  jj-mailbox task claim                                     Claim highest-priority ready task
  jj-mailbox task complete <task-id> [--hook <command>]     Complete a task (with optional quality gate)
  jj-mailbox task list [<status>|all]                       List tasks (default: all)
  jj-mailbox sync [--interval <seconds>]                    Run sync loop
  jj-mailbox watch [--agent <name>] [--exec <command>]      Watch inbox for new local messages
  jj-mailbox status                                         Show all agents' status
  jj-mailbox help                                           Show this help

Environment:
  JJ_MAILBOX_REPO     Path to mailbox repo (default: current directory)
  JJ_MAILBOX_AGENT    Current agent name (default: hostname)
  JJ_MAILBOX_INTERVAL Sync interval in seconds (default: ${DEFAULT_INTERVAL})
EOF
}

# --- Helpers ---

get_repo() {
  echo "${JJ_MAILBOX_REPO:-$(pwd)}"
}

get_agent() {
  echo "${JJ_MAILBOX_AGENT:-$(hostname)}"
}

ensure_repo() {
  local repo
  repo="$(get_repo)"
  if [[ ! -d "${repo}/.jj" ]]; then
    err "Not a jj-mailbox repo: ${repo}"
    err "Run 'jj-mailbox init <path>' first."
    exit 1
  fi
}

ensure_jj() {
  if ! command -v jj &>/dev/null; then
    err "jj (Jujutsu) is not installed."
    err "Install: https://jj-vcs.dev/docs/install/"
    exit 1
  fi
}

gen_id() {
  # Try multiple methods for portability
  if command -v xxd &>/dev/null; then
    head -c 4 /dev/urandom | xxd -p
  elif command -v od &>/dev/null; then
    head -c 4 /dev/urandom | od -An -tx1 | tr -d ' \n'
  else
    printf '%04x%04x' $RANDOM $RANDOM
  fi
}

ts_filename() {
  date -u +"%Y-%m-%dT%H-%M-%SZ"
}

ts_iso() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

# --- Commands ---

run_exec_hook() {
  local exec_cmd="${1:-}"
  [[ -z "${exec_cmd}" ]] && return 0

  log "Running hook: ${exec_cmd}"
  bash -c "${exec_cmd}"
}

watch_with_polling() {
  local inbox_dir="${1:?}"
  local exec_cmd="${2:-}"
  local poll_interval="${3:-3}"
  local baseline=0

  baseline=$(find "${inbox_dir}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
  while true; do
    local count
    count=$(find "${inbox_dir}" -maxdepth 1 -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${count}" -gt "${baseline}" ]]; then
      local delta=$((count - baseline))
      ok "📬 ${delta} new message(s) detected"
      run_exec_hook "${exec_cmd}"
    fi
    baseline="${count}"
    sleep "${poll_interval}"
  done
}

cmd_init() {
  ensure_jj
  local repo="${1:-.}"
  local remote="${2:-}"

  mkdir -p "${repo}"
  cd "${repo}"

  if [[ -d .jj ]]; then
    warn "Already initialized: ${repo}"
    return 0
  fi

  # Initialize jj with git backend
  if [[ -n "${remote}" ]]; then
    log "Cloning from ${remote}..."
    jj git clone --colocate "${remote}" .
  else
    log "Initializing new mailbox repo..."
    jj git init --colocate
  fi

  # Create directory structure
  mkdir -p agents inbox shared/{tasks,knowledge,artifacts}

  # Create AGENTS.md
  cat > AGENTS.md <<'AGENTS'
# Registered Agents

| Name | Description | Status |
|------|-------------|--------|

<!-- Auto-updated by jj-mailbox -->
AGENTS

  # Create .gitignore
  cat > .gitignore <<'GI'
# OS
.DS_Store
Thumbs.db

# Temp
*.tmp
*.swp
GI

  jj commit -m "Initialize jj-mailbox repo"

  ok "Mailbox repo initialized at: $(pwd)"
  if [[ -z "${remote}" ]]; then
    log "Tip: add a remote with 'jj git remote add origin <url>'"
  fi
}

cmd_register() {
  ensure_repo
  ensure_jj
  local name="${1:?Usage: jj-mailbox register <name>}"
  local desc="${2:-Agent ${name}}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  # Create agent directories
  mkdir -p "agents/${name}" "inbox/${name}/new" "inbox/${name}/processed"

  # Write profile
  cat > "agents/${name}/profile.json" <<EOF
{
  "name": "${name}",
  "description": "${desc}",
  "capabilities": [],
  "platform": "openclaw",
  "created": "$(ts_iso)"
}
EOF

  # Write initial status
  cat > "agents/${name}/status.json" <<EOF
{
  "status": "online",
  "last_seen": "$(ts_iso)",
  "current_task": null
}
EOF

  # Add placeholder to keep dirs in git
  touch "inbox/${name}/new/.gitkeep"
  touch "inbox/${name}/processed/.gitkeep"

  jj commit -m "Register agent: ${name}"

  ok "Agent '${name}' registered."
  log "Set JJ_MAILBOX_AGENT=${name} to use as current agent."
}

cmd_send() {
  ensure_repo
  ensure_jj
  local to="${1:?Usage: jj-mailbox send <to> <subject> <body> [--refs <ids>] [--type <type>]}"
  local subject="${2:?}"
  local body="${3:?}"
  local refs_arg=""
  local msg_type="message"
  local from
  from="$(get_agent)"
  local repo
  repo="$(get_repo)"

  # Parse optional flags (remaining args after positional 3)
  shift 3 || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --refs) refs_arg="${2:-}"; shift 2 ;;
      --type) msg_type="${2:-message}"; shift 2 ;;
      *) shift ;;
    esac
  done

  # Validate message type
  case "${msg_type}" in
    message|task|reply|broadcast|idle|approval_request|approval_response|shutdown) ;;
    *)
      err "Unknown message type: ${msg_type}"
      err "Valid types: message, task, reply, broadcast, idle, approval_request, approval_response, shutdown"
      exit 1
      ;;
  esac

  cd "${repo}"

  # Verify recipient exists
  if [[ ! -d "inbox/${to}/new" ]]; then
    err "Unknown agent: ${to}"
    err "Registered agents:"
    ls agents/ 2>/dev/null || echo "  (none)"
    exit 1
  fi

  local msg_id="msg-$(gen_id)"
  local ts
  ts="$(ts_filename)"
  local filename="${ts}_${from}_${msg_id}.json"

  # Build refs JSON array from comma-separated ids (pure bash, no python)
  local refs_json="[]"
  if [[ -n "${refs_arg}" ]]; then
    local _refs_arr _r _first=true
    refs_json="["
    IFS=',' read -ra _refs_arr <<< "${refs_arg}"
    for _r in "${_refs_arr[@]}"; do
      _r="${_r// /}"
      [[ -z "${_r}" ]] && continue
      ${_first} || refs_json+=","
      refs_json+="\"${_r}\""
      _first=false
    done
    refs_json+="]"
  fi

  cat > "inbox/${to}/new/${filename}" <<EOF
{
  "version": "0.1",
  "id": "${msg_id}",
  "timestamp": "$(ts_iso)",
  "from": "${from}",
  "to": "${to}",
  "type": "${msg_type}",
  "subject": "${subject}",
  "body": "${body}",
  "refs": ${refs_json},
  "metadata": {}
}
EOF

  jj commit -m "${from} → ${to}: ${subject}"

  ok "Message sent: ${from} → ${to}"
  log "  Subject: ${subject}"
  log "  Type: ${msg_type}"
  log "  File: inbox/${to}/new/${filename}"
  log "  ID: ${msg_id}"
  echo "${msg_id}"
}

cmd_inbox() {
  ensure_repo
  local agent="${1:-$(get_agent)}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  if [[ ! -d "${inbox_dir}" ]]; then
    err "No inbox for agent: ${agent}"
    exit 1
  fi

  local count
  count=$(find "${inbox_dir}" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')

  if [[ "${count}" -eq 0 ]]; then
    log "Inbox empty for ${agent}."
    return 0
  fi

  ok "${count} message(s) for ${agent}:"
  echo ""

  # Sort by filename (which starts with timestamp)
  find "${inbox_dir}" -name '*.json' | sort | while read -r f; do
    local from subject ts _fields
    # Single python3 call to extract all fields (instead of 3 separate calls)
    # Uses sys.argv to pass file path safely (no bash variable interpolation in python)
    _fields=$(python3 -c "
import json,sys
m=json.load(open(sys.argv[1]))
print(m.get('from','?') + '\t' + m.get('subject','?') + '\t' + m.get('timestamp','?'))
" "$f" 2>/dev/null) || _fields=$'?\t?\t?'
    IFS=$'\t' read -r from subject ts <<< "${_fields}"
    echo -e "  ${GREEN}From:${NC} ${from}  ${BLUE}Subject:${NC} ${subject}  ${YELLOW}Time:${NC} ${ts}"
  done
  echo ""
}

cmd_thread() {
  ensure_repo
  local msg_id="${1:?Usage: jj-mailbox thread <msg-id>}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  python3 - "$msg_id" <<'PY'
import json
import os
import sys
from collections import defaultdict

target_id = sys.argv[1]
messages = {}
children = defaultdict(list)

for root, _, files in os.walk("inbox"):
    for name in files:
        if not name.endswith(".json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path) as f:
                msg = json.load(f)
        except (OSError, json.JSONDecodeError):
            continue
        msg_id = msg.get("id")
        if not msg_id:
            continue
        msg["_path"] = path
        msg.setdefault("refs", [])
        messages[msg_id] = msg

for msg in messages.values():
    for ref in msg.get("refs", []):
        if ref in messages:
            children[ref].append(msg["id"])

if target_id not in messages:
    print(f"Message not found: {target_id}", file=sys.stderr)
    sys.exit(1)

component = set()
stack = [target_id]
while stack:
    current = stack.pop()
    if current in component:
        continue
    component.add(current)
    msg = messages[current]
    for ref in msg.get("refs", []):
        if ref in messages:
            stack.append(ref)
    stack.extend(children.get(current, []))

def in_component_refs(msg_id):
    return [ref for ref in messages[msg_id].get("refs", []) if ref in component]

roots = [
    msg_id for msg_id in component
    if not in_component_refs(msg_id)
]
if not roots:
    roots = [target_id]

def sort_key(msg_id):
    msg = messages[msg_id]
    return (msg.get("timestamp", ""), msg_id)

turn = 0
seen = set()

def render(msg_id, depth):
    global turn
    if msg_id in seen:
        return
    seen.add(msg_id)
    turn += 1
    msg = messages[msg_id]
    indent = "  " * depth
    refs = [ref for ref in msg.get("refs", []) if ref]
    refs_suffix = f"  [refs: {', '.join(refs)}]" if refs else ""
    print(
        f"{indent}Turn {turn}  "
        f"{msg.get('from', '?')} → {msg.get('to', '?')}  "
        f"\"{msg.get('subject', '?')}\"{refs_suffix}"
    )
    for child_id in sorted(children.get(msg_id, []), key=sort_key):
        if child_id in component:
            render(child_id, depth + 1)

for root_id in sorted(roots, key=sort_key):
    render(root_id, 0)

PY
}

cmd_read_and_process() {
  # Read one message and move to processed
  ensure_repo
  local agent="${1:-$(get_agent)}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  local processed_dir="inbox/${agent}/processed"

  local oldest
  oldest=$(find "${inbox_dir}" -name '*.json' 2>/dev/null | sort | head -1)

  if [[ -z "${oldest}" ]]; then
    echo ""
    return 1
  fi

  # Output the message content
  cat "${oldest}"

  # Move to processed
  mv "${oldest}" "${processed_dir}/"

  return 0
}

cmd_sync() {
  ensure_repo
  ensure_jj
  local interval="${1:-${JJ_MAILBOX_INTERVAL:-${DEFAULT_INTERVAL}}}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  log "Starting sync loop (interval: ${interval}s)"
  log "Repo: ${repo}"
  log "Press Ctrl+C to stop."
  echo ""

  while true; do
    # Update agent status
    local agent
    agent="$(get_agent)"
    if [[ -f "agents/${agent}/status.json" ]]; then
      # Pass file path and timestamp as arguments (no bash variable interpolation in python)
      python3 -c "
import json,sys
path, ts = sys.argv[1], sys.argv[2]
with open(path, 'r+') as f:
    s = json.load(f)
    s['last_seen'] = ts
    f.seek(0); json.dump(s, f, indent=2); f.truncate()
" "agents/${agent}/status.json" "$(ts_iso)" 2>/dev/null || true
    fi

    # Fetch
    if jj git fetch --all-remotes 2>/dev/null; then
      log "⬇ Fetched remote changes"
    fi

    # Snapshot working copy (jj does this automatically)
    jj status >/dev/null 2>&1 || true

    # Check inbox
    local count
    count=$(find "inbox/${agent}/new" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    if [[ "${count}" -gt 0 ]]; then
      ok "📬 ${count} new message(s) in inbox"
    fi

    # Push
    if jj git push --all 2>/dev/null; then
      log "⬆ Pushed local changes"
    fi

    sleep "${interval}"
  done
}

cmd_watch() {
  ensure_repo
  local agent="$(get_agent)"
  local exec_cmd=""
  local repo
  repo="$(get_repo)"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --agent)
        agent="${2:?Usage: jj-mailbox watch [--agent <name>] [--exec <command>]}"
        shift 2
        ;;
      --exec)
        exec_cmd="${2:?Usage: jj-mailbox watch [--agent <name>] [--exec <command>]}"
        shift 2
        ;;
      *)
        err "Unknown option for watch: $1"
        exit 1
        ;;
    esac
  done

  cd "${repo}"

  local inbox_dir="inbox/${agent}/new"
  if [[ ! -d "${inbox_dir}" ]]; then
    err "No inbox for agent: ${agent}"
    exit 1
  fi

  log "Watching ${inbox_dir} for new messages"
  if [[ -n "${exec_cmd}" ]]; then
    log "Hook command enabled"
  fi
  log "Press Ctrl+C to stop."

  if [[ "${JJ_MAILBOX_FORCE_POLL:-0}" == "1" ]]; then
    warn "Forced polling mode enabled"
    watch_with_polling "${inbox_dir}" "${exec_cmd}" 3
  elif command -v inotifywait >/dev/null 2>&1; then
    inotifywait -m -e create --format '%f' "${inbox_dir}" | while read -r file; do
      [[ "${file}" == *.json ]] || continue
      ok "📬 New message detected: ${file}"
      run_exec_hook "${exec_cmd}"
    done
  elif command -v fswatch >/dev/null 2>&1; then
    fswatch -0 --event Created "${inbox_dir}" | while IFS= read -r -d '' file; do
      [[ "${file}" == *.json ]] || continue
      ok "📬 New message detected: $(basename "${file}")"
      run_exec_hook "${exec_cmd}"
    done
  else
    warn "No inotifywait or fswatch found, falling back to 3s polling"
    watch_with_polling "${inbox_dir}" "${exec_cmd}" 3
  fi
}

cmd_status() {
  ensure_repo
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  log "Agent Status:"
  echo ""

  for agent_dir in agents/*/; do
    [[ -d "${agent_dir}" ]] || continue
    local name
    name=$(basename "${agent_dir}")
    local status="?"
    local last_seen="?"
    local inbox_count=0

    if [[ -f "${agent_dir}/status.json" ]]; then
      # Single python3 call to extract both fields (instead of 2 separate calls)
      local _status_fields
      _status_fields=$(python3 -c "
import json,sys
s=json.load(open(sys.argv[1]))
print(s.get('status','?'), s.get('last_seen','?'))
" "${agent_dir}/status.json" 2>/dev/null) || _status_fields="? ?"
      read -r status last_seen <<< "${_status_fields}"
    fi

    if [[ -d "inbox/${name}/new" ]]; then
      inbox_count=$(find "inbox/${name}/new" -name '*.json' 2>/dev/null | wc -l | tr -d ' ')
    fi

    local status_icon="⚪"
    [[ "${status}" == "online" ]] && status_icon="🟢"
    [[ "${status}" == "busy" ]] && status_icon="🟡"
    [[ "${status}" == "idle" ]] && status_icon="🔵"
    [[ "${status}" == "waiting_approval" ]] && status_icon="🟠"
    [[ "${status}" == "offline" ]] && status_icon="🔴"

    echo -e "  ${status_icon} ${name}  (${status})  📬 ${inbox_count} msg  🕐 ${last_seen}"
  done
  echo ""
}

cmd_set_status() {
  ensure_repo
  ensure_jj
  local new_status="${1:?Usage: jj-mailbox set-status <status> [--task <task-id>]}"
  local task_id=""
  local agent
  agent="$(get_agent)"
  local repo
  repo="$(get_repo)"

  # Validate status
  case "${new_status}" in
    online|busy|idle|offline|waiting_approval) ;;
    *)
      err "Unknown status: ${new_status}"
      err "Valid statuses: online, busy, idle, offline, waiting_approval"
      exit 1
      ;;
  esac

  # Parse optional --task flag
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --task) task_id="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  cd "${repo}"

  local status_file="agents/${agent}/status.json"
  if [[ ! -f "${status_file}" ]]; then
    err "Agent not registered: ${agent}"
    exit 1
  fi

  # Update status.json via python3 for safe JSON manipulation
  python3 -c "
import json,sys
path, new_status, ts, task_id = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
with open(path, 'r+') as f:
    s = json.load(f)
    s['status'] = new_status
    s['last_seen'] = ts
    s['current_task'] = task_id if task_id else None
    f.seek(0); json.dump(s, f, indent=2); f.truncate()
" "${status_file}" "${new_status}" "$(ts_iso)" "${task_id}"

  jj commit -m "${agent}: status → ${new_status}"

  ok "Status updated: ${agent} → ${new_status}"
  if [[ -n "${task_id}" ]]; then
    log "  Task: ${task_id}"
  fi
}

cmd_task() {
  local subcmd="${1:?Usage: jj-mailbox task <create|claim|complete|list> [args...]}"
  shift
  case "${subcmd}" in
    create)   cmd_task_create "$@" ;;
    claim)    cmd_task_claim "$@" ;;
    complete) cmd_task_complete "$@" ;;
    list)     cmd_task_list "$@" ;;
    *)
      err "Unknown task subcommand: ${subcmd}"
      err "Valid subcommands: create, claim, complete, list"
      exit 1
      ;;
  esac
}

cmd_task_create() {
  ensure_repo
  ensure_jj
  local subject="${1:?Usage: jj-mailbox task create <subject> [--priority <n>] [--blocked-by <id1,id2,...>]}"
  local priority=0
  local blocked_by_arg=""
  local agent
  agent="$(get_agent)"
  local repo
  repo="$(get_repo)"

  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --priority) priority="${2:-0}"; shift 2 ;;
      --blocked-by) blocked_by_arg="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  cd "${repo}"
  mkdir -p shared/tasks

  local task_id="task-$(gen_id)"

  # Build blockedBy JSON array
  local blocked_json="[]"
  if [[ -n "${blocked_by_arg}" ]]; then
    local _arr _item _first=true
    blocked_json="["
    IFS=',' read -ra _arr <<< "${blocked_by_arg}"
    for _item in "${_arr[@]}"; do
      _item="${_item// /}"
      [[ -z "${_item}" ]] && continue
      ${_first} || blocked_json+=","
      blocked_json+="\"${_item}\""
      _first=false
    done
    blocked_json+="]"
  fi

  cat > "shared/tasks/${task_id}.json" <<EOF
{
  "version": "0.1",
  "id": "${task_id}",
  "subject": "${subject}",
  "status": "pending",
  "assignee": null,
  "created_by": "${agent}",
  "created_at": "$(ts_iso)",
  "priority": ${priority},
  "blocks": [],
  "blockedBy": ${blocked_json},
  "metadata": {}
}
EOF

  jj commit -m "task: create ${task_id} — ${subject}"

  ok "Task created: ${task_id}"
  log "  Subject: ${subject}"
  log "  Priority: ${priority}"
  if [[ -n "${blocked_by_arg}" ]]; then
    log "  Blocked by: ${blocked_by_arg}"
  fi
  echo "${task_id}"
}

cmd_task_claim() {
  ensure_repo
  ensure_jj
  local agent
  agent="$(get_agent)"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  # Find the highest-priority ready task using python3
  local claimed_id
  claimed_id=$(python3 - "${agent}" <<'PY'
import json, os, sys, glob

agent = sys.argv[1]
tasks_dir = "shared/tasks"
if not os.path.isdir(tasks_dir):
    sys.exit(1)

# Load all tasks
tasks = {}
for path in glob.glob(os.path.join(tasks_dir, "task-*.json")):
    try:
        with open(path) as f:
            t = json.load(f)
        tasks[t["id"]] = t
        t["_path"] = path
    except (OSError, json.JSONDecodeError, KeyError):
        continue

# Find completed task IDs
completed = {tid for tid, t in tasks.items() if t.get("status") == "completed"}

# Find claimable: pending + all blockedBy completed
candidates = []
for t in tasks.values():
    if t.get("status") != "pending":
        continue
    blocked_by = t.get("blockedBy", [])
    if all(dep in completed for dep in blocked_by):
        candidates.append(t)

if not candidates:
    sys.exit(1)

# Sort by priority (lowest number = highest priority), then by created_at
candidates.sort(key=lambda t: (t.get("priority", 0), t.get("created_at", "")))
best = candidates[0]

# Claim it
best["status"] = "in_progress"
best["assignee"] = agent
with open(best["_path"], "w") as f:
    del best["_path"]
    json.dump(best, f, indent=2)

print(best["id"])
PY
  ) || true

  if [[ -z "${claimed_id}" ]]; then
    log "No claimable tasks found."
    return 1
  fi

  jj commit -m "${agent}: claim ${claimed_id}"

  ok "Claimed task: ${claimed_id}"
  echo "${claimed_id}"
}

cmd_task_complete() {
  ensure_repo
  ensure_jj
  local task_id="${1:?Usage: jj-mailbox task complete <task-id> [--hook <command>]}"
  local hook_cmd=""
  local agent
  agent="$(get_agent)"
  local repo
  repo="$(get_repo)"

  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --hook) hook_cmd="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  cd "${repo}"

  local task_file="shared/tasks/${task_id}.json"
  if [[ ! -f "${task_file}" ]]; then
    err "Task not found: ${task_id}"
    exit 1
  fi

  # Run hook if provided
  if [[ -n "${hook_cmd}" ]]; then
    log "Running quality gate: ${hook_cmd}"
    local hook_stderr hook_rc
    hook_stderr=$(bash -c "${hook_cmd}" 2>&1 1>/dev/null) && hook_rc=0 || hook_rc=$?

    if [[ "${hook_rc}" -eq 2 ]]; then
      warn "Quality gate rejected completion for ${task_id}"
      # Send feedback message to the agent
      local feedback_body="${hook_stderr:-Quality gate failed with no output.}"
      # Auto-send a system feedback message to the agent's inbox
      if [[ -d "inbox/${agent}/new" ]]; then
        local fb_id="msg-$(gen_id)"
        local fb_ts
        fb_ts="$(ts_filename)"
        local fb_file="${fb_ts}_system_${fb_id}.json"
        cat > "inbox/${agent}/new/${fb_file}" <<EOF
{
  "version": "0.1",
  "id": "${fb_id}",
  "timestamp": "$(ts_iso)",
  "from": "system",
  "to": "${agent}",
  "type": "reply",
  "subject": "Task ${task_id} completion rejected",
  "body": $(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "${feedback_body}"),
  "refs": ["${task_id}"],
  "metadata": {}
}
EOF
        jj commit -m "system: quality gate rejected ${task_id}"
      fi
      err "Hook exited with code 2 — task stays in_progress. Feedback sent."
      return 2
    elif [[ "${hook_rc}" -ne 0 ]]; then
      err "Hook failed with exit code ${hook_rc} — task unchanged."
      return 1
    fi
    ok "Quality gate passed."
  fi

  # Mark task as completed
  python3 -c "
import json,sys
path, ts = sys.argv[1], sys.argv[2]
with open(path, 'r+') as f:
    t = json.load(f)
    t['status'] = 'completed'
    f.seek(0); json.dump(t, f, indent=2); f.truncate()
" "${task_file}" "$(ts_iso)"

  jj commit -m "${agent}: complete ${task_id}"

  ok "Task completed: ${task_id}"
}

cmd_task_list() {
  ensure_repo
  local status_filter="${1:-all}"
  local repo
  repo="$(get_repo)"
  cd "${repo}"

  python3 - "${status_filter}" <<'PY'
import json, os, sys, glob

status_filter = sys.argv[1]
tasks_dir = "shared/tasks"
if not os.path.isdir(tasks_dir):
    print("No tasks found.")
    sys.exit(0)

tasks = []
for path in sorted(glob.glob(os.path.join(tasks_dir, "task-*.json"))):
    try:
        with open(path) as f:
            t = json.load(f)
        tasks.append(t)
    except (OSError, json.JSONDecodeError):
        continue

if not tasks:
    print("No tasks found.")
    sys.exit(0)

# Filter
if status_filter != "all":
    tasks = [t for t in tasks if t.get("status") == status_filter]

if not tasks:
    print(f"No tasks with status '{status_filter}'.")
    sys.exit(0)

# Sort by priority then created_at
tasks.sort(key=lambda t: (t.get("priority", 0), t.get("created_at", "")))

icons = {"pending": "⏳", "in_progress": "🔨", "completed": "✅", "blocked": "🚫"}
for t in tasks:
    icon = icons.get(t.get("status", ""), "❓")
    assignee = t.get("assignee") or "unassigned"
    blocked = t.get("blockedBy", [])
    blocked_str = f"  [blocked by: {', '.join(blocked)}]" if blocked else ""
    print(f"  {icon} {t['id']}  P{t.get('priority',0)}  ({t.get('status','?')})  {assignee}  \"{t.get('subject','?')}\"{blocked_str}")

PY
}

# --- Main ---

main() {
  local cmd="${1:-help}"
  shift || true

  case "${cmd}" in
    init)       cmd_init "$@" ;;
    register)   cmd_register "$@" ;;
    send)       cmd_send "$@" ;;
    inbox)      cmd_inbox "$@" ;;
    thread)     cmd_thread "$@" ;;
    read)       cmd_read_and_process "$@" ;;
    sync)       cmd_sync "$@" ;;
    watch)      cmd_watch "$@" ;;
    status)     cmd_status "$@" ;;
    set-status) cmd_set_status "$@" ;;
    task)       cmd_task "$@" ;;
    version)    echo "jj-mailbox v${VERSION}" ;;
    help|*)     usage ;;
  esac
}

main "$@"
